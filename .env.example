# Playground / LuvNotes
# Preferred: let the importer perform the same Firebase/Playground auth bootstrap
# as the web app and obtain a fresh actor-scoped ID token.
PLAYGROUND_EMAIL=replace-me
PLAYGROUND_PASSWORD=replace-me

# Optional fallback: a manually copied final Playground Firebase ID token.
# Leave blank when using email/password authentication.
PLAYGROUND_TOKEN=

PLAYGROUND_SCHOOL_ID=CHESTERFIELD
PLAYGROUND_STUDENT_ID=replace-me
PLAYGROUND_GUARDIAN_ID=replace-me

# Optional: bypass /api/public/account auto-resolution if needed.
PLAYGROUND_ACCOUNT_ID=

# Synology user ownership
# Find these by SSHing to the NAS and running: id <username>
PUID=1026
PGID=100

# Storage
LUVNOTES_ARCHIVE_PATH=/volume1/docker/luvnotes/archive
SYNOLOGY_PHOTOS_PATH=/volume1/homes/<username>/Photos/LuvNotes

# Optional
TZ=America/Chicago
PAGE_SIZE=50

# Optional recovery/debug controls.
# Epoch milliseconds used only on the first media-gallery request together with
# reset=true. Leave blank for a normal newest-to-oldest full crawl.
PLAYGROUND_START_AFTER=

# Prevent a pathological media file from hanging ExifTool indefinitely.
EXIFTOOL_TIMEOUT_SECONDS=90
